<%- include('../partials/header') %>

<section class="product-page">
  <div class="container">
    <div class="product-content">
      <div class="product-info">
        <h1><%= product.name %></h1>
        <p class="product-description"><%= product.description %></p>
        
        <div class="product-price-section">
          <span class="product-price">$<%= (product.price_cents / 100).toFixed(0) %></span>
          <span class="product-price-note">One-time payment. Instant PDF download.</span>
        </div>

        <button id="checkout-button" class="button button-primary button-large" data-price-id="<%= product.id %>">
          Buy Now — $<%= (product.price_cents / 100).toFixed(0) %>
        </button>

        <div class="product-badges">
          <span>&#9989; Instant Download</span>
          <span>&#128274; Secure Payment</span>
          <span>&#128230; PDF Format</span>
        </div>
      </div>

      <div class="product-details">
        <h2>What's Inside the Guide</h2>
        <ul class="product-features-list">
          <li><strong>Chapter 1:</strong> Understanding Credit Reports & Scores</li>
          <li><strong>Chapter 2:</strong> How to Get Your Free Credit Reports</li>
          <li><strong>Chapter 3:</strong> Reviewing Your Reports — Step by Step</li>
          <li><strong>Chapter 4:</strong> Identifying and Documenting Errors</li>
          <li><strong>Chapter 5:</strong> The Dispute Process Explained</li>
          <li><strong>Chapter 6:</strong> Sample Dispute Letters & Templates</li>
          <li><strong>Chapter 7:</strong> Handling Fraud and Identity Theft</li>
          <li><strong>Chapter 8:</strong> Building Better Credit Habits</li>
          <li><strong>Chapter 9:</strong> Monitoring Your Credit Progress</li>
          <li><strong>Chapter 10:</strong> Frequently Asked Questions</li>
          <li><strong>Appendix:</strong> Checklists, Templates & Resources</li>
        </ul>
      </div>
    </div>

    <div class="product-guarantee">
      <h3>Our Refund Policy</h3>
      <p>We stand behind the quality of our educational guide. If you're not satisfied, contact us within 14 days of purchase for a full refund.</p>
      <a href="/refund-policy">Read our full refund policy →</a>
    </div>
  </div>
</section>

<% if (typeof stripePublishableKey !== 'undefined') { %>
<script>
  const stripePublishableKey = '<%= stripePublishableKey %>';
</script>
<% } %>

<%- include('../partials/footer') %>