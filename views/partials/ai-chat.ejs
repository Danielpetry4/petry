<!-- AI Chat Widget -->

<!-- Floating bubble button -->
<button id="chat-bubble-btn" class="ai-chat-bubble-btn" aria-label="Open Credit Assistant">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a4 4 0 0 1-4 4H7l-4 4V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"></path>
  </svg>
</button>

<!-- Chat window -->
<div id="chat-container" class="ai-chat-container closed">
  <div class="ai-chat-header">
    <div class="ai-chat-avatar assistant" aria-hidden="true">AI</div>
    <div class="ai-chat-header-text">
      <h3>Credit Assistant</h3>
      <p>Ask questions about credit reports and the guide</p>
    </div>
    <button id="chat-close-btn" class="ai-chat-close-btn" aria-label="Close chat">×</button>
  </div>

  <div id="chat-messages" class="ai-chat-messages" role="log" aria-live="polite" aria-label="Chat messages">
    <div class="ai-chat-message assistant">
      <div class="ai-chat-avatar assistant">AI</div>
      <div class="ai-chat-bubble">
        Hello! I'm here to answer general questions about credit reports, dispute processes, and credit building. How can I help you today?
      </div>
    </div>
  </div>

  <form id="chat-form" action="/api/chat" method="POST">
    <div class="ai-chat-input">
      <label for="chat-input" class="sr-only">Type your message</label>
      <textarea id="chat-input" placeholder="Type your question here..." rows="1" aria-label="Chat message"></textarea>
      <button id="chat-send" type="submit" class="ai-chat-send" aria-label="Send message">Send</button>
    </div>
  </form>

  <div class="ai-chat-disclaimer">
    This AI assistant provides general educational information only. It does not provide legal, financial, or credit repair advice. Responses may not be accurate or complete.
  </div>
</div>
