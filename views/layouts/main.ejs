<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title ? title + ' — ' : '' %>DIY Credit Repair Guide</title>
  <meta name="description" content="<%= locals.metaDescription || 'A practical educational PDF guide that teaches consumers how to review credit reports, dispute possible errors, handle fraud issues, and build better credit habits.' %>">
  
  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📘</text></svg>">
  
  <% if (locals.canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  
  <!-- Open Graph -->
  <meta property="og:title" content="<%= locals.ogTitle || 'DIY Credit Repair Guide — Take Control of Your Credit' %>">
  <meta property="og:description" content="<%= locals.ogDescription || 'A practical educational guide that teaches you how to review credit reports, dispute errors, and build better credit habits.' %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= locals.ogUrl || 'https://diycreditrepairguide.com' %>">
</head>
<body class="<%= locals.bodyClass || '' %>">

  <!-- Header -->
  <%- include('../partials/header') %>

  <!-- Main Content -->
  <main>
    <%- body %>
  </main>

  <!-- AI Chat (not on admin pages) -->
  <% if (!locals.isAdmin) { %>
    <%- include('../partials/ai-chat') %>
  <% } %>

  <!-- Footer -->
  <%- include('../partials/footer') %>

  <!-- JavaScript -->
  <script src="/js/main.js"></script>
  
  <% if (locals.extraScripts) { %>
    <%- extraScripts %>
  <% } %>
</body>
</html>