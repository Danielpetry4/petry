# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Session
SESSION_SECRET=change-this-to-a-random-secret-string

# Database
DATABASE_PATH=./data/app.db

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_product_price_id

# JWT (Admin auth)
JWT_SECRET=change-this-to-a-random-jwt-secret
JWT_EXPIRES_IN=24h

# Email (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@diycreditrepair.com
EMAIL_ADMIN=admin@diycreditrepair.com

# Admin
ADMIN_EMAIL=admin@diycreditrepair.com
ADMIN_PASSWORD_HASH=bcrypt_hash_will_be_set_in_init

# Product config
PDF_PRICE_IN_CENTS=2900
PDF_FILE_PATH=./data/guide.pdf

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100